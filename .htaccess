# ЭКСПЕРТ — статический лендинг на виртуальном хостинге Джино (Apache 2.4).
# Тот же набор, что работает на sport.caspol.ru
AddDefaultCharset utf-8
Options -Indexes
DirectoryIndex index.html

# --- Только HTTPS + без www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Джино держит Apache за прокси: %{HTTPS} тут врёт и даёт вечный редирект,
  # правильное условие — заголовок от прокси (код из справки Джино)
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- MIME-типы, которых у Apache может не быть ---
<IfModule mod_mime.c>
  AddType image/webp            .webp
  AddType image/avif            .avif
  AddType image/svg+xml         .svg
  AddType image/x-icon          .ico
  AddType video/mp4             .mp4
  AddType font/woff2            .woff2
  AddType font/woff             .woff
  # Пачки кадров ролика для телефона (20 WebP подряд) — бинарные, не сжимаются повторно
  AddType application/octet-stream .bin
</IfModule>

# --- Сжатие (у Джино включён gzip, brotli нет). Картинки, видео и .bin уже сжаты ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Кэширование ---
<IfModule mod_headers.c>
  # Файлы с хэшем в имени (скрипты, стили, шрифты из assets/) — можно навсегда
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Картинки, кадры, пачки кадров, видео — имена без хэша, месяц
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm|bin)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML всегда свежий, иначе посетитель увидит старую версию после выкладки
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
